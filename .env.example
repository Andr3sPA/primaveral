DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
NODE_ENV="development"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_URL="cloudinary://your-api-key:your-api-secret@your-cloud-name"
AUTH_SECRET="generate-a-long-random-secret"
BREVO_API_KEY="your-brevo-api-key"
API_KEY_BREVO="your-brevo-api-key"
BREVO_SENDER_EMAIL="verified-sender@example.com"
BREVO_SENDER_NAME="Primaveral Bordados"
# Canonical public app origin; use the production domain in production.
APP_URL="http://localhost:3000"
# NextAuth URL only; account emails always use APP_URL.
AUTH_URL="http://localhost:3000"
# In a local .env file, escape literal dollar signs with a backslash.
CRON_SECRET="replace-with-a-random-secret-at-least-32-characters"
META_PAGE_ID="your-facebook-page-id"
META_INSTAGRAM_USER_ID="your-instagram-professional-account-id"
META_PAGE_ACCESS_TOKEN="configure-only-in-server-environment"
# Optional alias accepted when META_PAGE_ACCESS_TOKEN is unset:
# META_ACCESS_TOKEN="configure-only-in-server-environment"
META_GRAPH_API_VERSION="v27.0"

# Wompi Sandbox. Set these variables together on an HTTPS Preview.
# WOMPI_LLAVE_PUBLICA="pub_test_..."
# WOMPI_LLAVE_PRIVADA="prv_test_..."
# WOMPI_EVENTOS="test_events_..."
# WOMPI_INTEGRIDAD="test_integrity_..."
# WOMPI_REDIRECT_URL="https://your-preview.example.com/checkout/resultado"
WOMPI_LIVE_PAYMENTS_ENABLED="false"
